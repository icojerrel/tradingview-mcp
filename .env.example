# TradingView credentials
TV_USERNAME=your_username_or_email
TV_PASSWORD=your_password

# Optional: path to persist session cookies (default: .tv_session.json)
TV_SESSION_FILE=.tv_session.json

# ── TradingView app MCP (dist/app/index.js) ──
# cdp (default) = attach to TradingView Desktop started with --remote-debugging-port
# launch        = open an own Chromium window on tradingview.com/chart
TV_APP_MODE=cdp
TV_CDP_URL=http://127.0.0.1:9222
# Set to 1 to expose the app_evaluate tool (runs arbitrary JS in the app)
TV_APP_ALLOW_EVAL=0

# ── Tradovate MCP (dist/tradovate/index.js) ──
# demo = paper trading (default). live is READ-ONLY unless TRADOVATE_LIVE_TRADING=1.
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
# API key (Tradovate → Application Settings → API Access)
TRADOVATE_CID=
TRADOVATE_SEC=
# Optional: account name, default = first account
TRADOVATE_ACCOUNT=
# Risk limits
TRADOVATE_MAX_ORDER_QTY=1
TRADOVATE_MAX_POSITION=2
TRADOVATE_MAX_ORDERS_PER_DAY=20
# Optional: comma separated products, e.g. MES,MNQ
TRADOVATE_ALLOWED_PRODUCTS=
