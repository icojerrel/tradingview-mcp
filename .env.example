# TradingView credentials
TV_USERNAME=your_username_or_email
TV_PASSWORD=your_password

# Optional: path to persist session cookies (default: .tv_session.json)
TV_SESSION_FILE=.tv_session.json

# ── TradingView app MCP (dist/app/index.js) ──
# cdp (default) = attach to TradingView Desktop started with --remote-debugging-port
# launch        = open an own Chromium window on tradingview.com/chart
TV_APP_MODE=cdp
TV_CDP_URL=http://127.0.0.1:9222
# Set to 1 to expose the app_evaluate tool (runs arbitrary JS in the app)
TV_APP_ALLOW_EVAL=0

# ── Trading MCP (dist/trading/index.js) ──
# paper (default) = built-in simulator on TradingView prices, no broker account needed
# alpaca          = Alpaca (ALPACA_ENV=paper by default)
# tradovate       = Tradovate futures (TRADOVATE_ENV=demo by default)
TRADING_BROKER=paper
# Live accounts are READ-ONLY unless this is 1
TRADING_LIVE_TRADING=0
# Risk limits
TRADING_MAX_ORDER_QTY=1
TRADING_MAX_POSITION=2
TRADING_MAX_ORDERS_PER_DAY=20
# Optional: comma separated products, e.g. AAPL,BTCUSDT or MES,MNQ
TRADING_ALLOWED_PRODUCTS=

# Paper broker
TRADING_PAPER_START_CASH=100000
# Futures point values, e.g. CME_MINI:MES1!=5,CME_MINI:MNQ1!=2
TRADING_PAPER_POINT_VALUES=

# Alpaca (https://app.alpaca.markets → Paper account → API keys)
ALPACA_ENV=paper
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Tradovate (API Access add-on → Application Settings → API Access)
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_ACCOUNT=
